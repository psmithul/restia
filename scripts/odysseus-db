#!/usr/bin/env python3
"""odysseus-db — inspect schema revision or adopt a verified legacy database."""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "_lib"))
from cli import common_parser, emit, run  # noqa: E402
from src.database_migrations import database_status, stamp_legacy_baseline


def cmd_status(args) -> None:
    emit(database_status(), args)


def cmd_stamp_legacy(args) -> None:
    emit(stamp_legacy_baseline().as_dict(), args)


def _build_parser():
    parser = common_parser("odysseus-db", __doc__ or "")
    common = parser._common_parents[0]
    sub = parser.add_subparsers(dest="cmd", required=True)

    status = sub.add_parser("status", parents=[common])
    status.set_defaults(func=cmd_status)

    stamp = sub.add_parser("stamp-legacy", parents=[common])
    stamp.set_defaults(func=cmd_stamp_legacy)
    return parser


if __name__ == "__main__":
    sys.exit(run(_build_parser()))
