#!/usr/bin/env python3
"""odysseus-backup — snapshot + restore of the data directory.

Backs up everything the app keeps under `data/`: the SQLite DB, the
Fernet key, JSON state files, RAG indexes, personal docs, attachments,
WhatsApp session, etc. Output is a gzip tarball — composable with cron
+ scp + s3cmd. The backup uses `sqlite3 .backup` for the DB so the
app can keep running during the snapshot.

    odysseus-backup snapshot                       # → backups/YYYY-MM-DD-HHMMSS.tar.gz
    odysseus-backup snapshot --out /mnt/nas/x.tgz
    odysseus-backup list                           # entries in backups/
    odysseus-backup restore PATH [--yes]           # overwrite current data/ from a tarball
    odysseus-backup verify PATH                    # tarball integrity check (no extract)

Restore is destructive: it overwrites `data/` in place. Always pass
`--yes` so a typo can't nuke your live state.
"""

from __future__ import annotations

import os
import sys
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "_lib"))
from cli import quiet_logs, emit, fail, common_parser, run, REPO_ROOT as _REPO_ROOT
quiet_logs()

import argparse
from contextlib import contextmanager
import shutil
import sqlite3
import stat
import tarfile
import tempfile
from datetime import datetime
from pathlib import Path, PurePosixPath

def _runtime_path(value: str | None, default: Path) -> Path:
    path = Path(value).expanduser() if value else default
    return path if path.is_absolute() else (_REPO_ROOT / path)


_DATA_DIR = _runtime_path(
    os.getenv("RESTIA_DATA_DIR") or os.getenv("ODYSSEUS_DATA_DIR"),
    _REPO_ROOT / "data",
)
_BACKUP_DIR = _runtime_path(
    os.getenv("RESTIA_BACKUP_DIRECTORY")
    or os.getenv("ODYSSEUS_BACKUP_DIRECTORY"),
    _REPO_ROOT / "backups",
)
_MAX_PASSPHRASE_FILE_BYTES = 64 * 1024

# Stuff inside data/ that we explicitly skip — anything we can re-derive
# from the SQLite DB + JSON state. Keeps the tarball small.
_SKIP_PATTERNS = {
    "mail-attachments",     # cached IMAP attachment extractions
    "deep_research",        # research runs are large; back up explicitly via --include-research
    "personal_uploads",     # uploaded files; usually wanted, included by default actually
}


def _sqlite_safe_copy(src: Path, dst: Path) -> None:
    """Copy a database without ever raw-copying a live SQLite file.

    Files with a ``.db`` suffix are not necessarily SQLite, so non-SQLite
    files retain the old byte-copy behavior.  Once the SQLite header is
    present, however, a failed online backup is fatal: silently falling back to
    a raw copy could produce a snapshot that verifies as a tarball but cannot
    be restored as a consistent database.
    """
    with src.open("rb") as source_file:
        sqlite_header = source_file.read(16)
    if sqlite_header != b"SQLite format 3\x00":
        shutil.copy2(src, dst)
        return

    src_conn = None
    dst_conn = None
    try:
        src_conn = sqlite3.connect(str(src))
        dst_conn = sqlite3.connect(str(dst))
        with dst_conn:
            src_conn.backup(dst_conn)
    except Exception as exc:
        raise RuntimeError(f"online SQLite backup failed for {src.name}") from exc
    finally:
        if src_conn is not None:
            src_conn.close()
        if dst_conn is not None:
            dst_conn.close()


def _reject_output_inside_data(out_path: Path) -> None:
    try:
        resolved = out_path.resolve()
        data_root = _DATA_DIR.resolve()
        resolved.relative_to(data_root)
    except ValueError:
        return
    fail("backup output path must be outside data/")


def _read_passphrase_file(path_value: str | None) -> bytes:
    if not path_value:
        fail("an external --passphrase-file is required for encrypted backups")
    path = Path(path_value).expanduser()
    try:
        info = path.lstat()
    except OSError:
        fail("backup passphrase file is not readable")
    if path.is_symlink() or not stat.S_ISREG(info.st_mode):
        fail("backup passphrase file must be a regular non-symlink file")
    if info.st_size > _MAX_PASSPHRASE_FILE_BYTES:
        fail("backup passphrase file is too large")
    if os.name != "nt" and stat.S_IMODE(info.st_mode) & 0o077:
        fail("backup passphrase file must be owner-only (chmod 600)")
    try:
        secret = path.read_bytes().rstrip(b"\r\n")
    except OSError:
        fail("backup passphrase file is not readable")
    if not secret:
        fail("backup passphrase file is empty")
    return secret


@contextmanager
def _materialized_backup(path: Path, passphrase_file: str | None):
    from src.backup_encryption import (
        BackupEncryptionError,
        decrypt_backup,
        is_encrypted_backup,
    )

    encrypted = is_encrypted_backup(path)
    if not encrypted:
        if passphrase_file:
            fail("--passphrase-file was supplied for a plaintext backup")
        yield path
        return

    secret = _read_passphrase_file(passphrase_file)
    with tempfile.TemporaryDirectory(prefix="restia-backup-decrypt-") as tmp:
        plaintext = Path(tmp) / "backup.tar.gz"
        try:
            decrypt_backup(path, plaintext, secret)
        except BackupEncryptionError as exc:
            fail(str(exc))
        yield plaintext


def cmd_snapshot(args):
    """Write a tar.gz of the entire data/ directory.

    SQLite databases are dumped via .backup() into a temp file before
    being added to the tar, so a running web app can't corrupt the
    snapshot. Everything else is copied as-is."""
    database_url = str(os.getenv("DATABASE_URL") or "").strip().lower()
    database_mode = str(
        os.getenv("RESTIA_DATABASE_MODE")
        or os.getenv("ODYSSEUS_DATABASE_MODE")
        or "local-single"
    ).strip().lower()
    if database_mode == "shared" or database_url.startswith(("postgresql:", "postgresql+", "postgres:")):
        fail(
            "local snapshot refuses shared PostgreSQL mode because data/ does "
            "not contain the authoritative database or shared blob mount; "
            "create and verify an operator PostgreSQL + blob-store backup"
        )
    if not _DATA_DIR.is_dir():
        fail(f"no data dir at {_DATA_DIR}")
    _BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    passphrase_file = getattr(args, "encrypt_with_passphrase_file", None)
    suffix = ".tar.gz.restia" if passphrase_file else ".tar.gz"
    out_path = Path(args.out) if args.out else (
        _BACKUP_DIR / f"odysseus-backup-{datetime.now().strftime('%Y%m%d-%H%M%S')}{suffix}"
    )
    _reject_output_inside_data(out_path)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    plaintext_path = out_path
    plaintext_temporary = None
    if passphrase_file:
        descriptor, name = tempfile.mkstemp(
            prefix=f".{out_path.name}.", suffix=".plaintext", dir=out_path.parent
        )
        os.close(descriptor)
        plaintext_temporary = Path(name)
        plaintext_temporary.unlink()
        plaintext_path = plaintext_temporary

    sqlite_dbs = [p for p in _DATA_DIR.rglob("*.db") if p.is_file() and not p.is_symlink()]
    files_added = 0
    total_bytes = 0

    with tempfile.TemporaryDirectory() as tmp_str:
        tmp = Path(tmp_str)
        # Snapshot SQLite DBs to the temp dir first.
        db_map: dict[Path, Path] = {}
        for db in sqlite_dbs:
            rel = db.relative_to(_DATA_DIR)
            staged = tmp / rel
            staged.parent.mkdir(parents=True, exist_ok=True)
            _sqlite_safe_copy(db, staged)
            db_map[db] = staged

        # Build beside the destination and atomically publish only after the
        # tar writer has finalized successfully. A disk-full/interrupted run
        # must not leave a partial archive with the requested final name.
        with tempfile.NamedTemporaryFile(
            prefix=f".{plaintext_path.name}.",
            suffix=".partial",
            dir=plaintext_path.parent,
            delete=False,
        ) as pending_file:
            pending_path = Path(pending_file.name)
        try:
            with tarfile.open(pending_path, "w:gz") as tar:
                for p in sorted(_DATA_DIR.rglob("*")):
                    if not p.is_file() or p.is_symlink():
                        continue
                    rel = p.relative_to(_DATA_DIR.parent)
                    # Skip user-asked-to-skip categories
                    if not args.include_research and "deep_research" in rel.parts:
                        continue
                    if not args.include_attachments and "mail-attachments" in rel.parts:
                        continue
                    # Substitute SQLite snapshots for the live files
                    source = db_map.get(p, p)
                    tar.add(source, arcname=str(rel))
                    files_added += 1
                    total_bytes += source.stat().st_size

            if os.name != "nt":
                os.chmod(pending_path, 0o600)
            os.replace(pending_path, plaintext_path)
        finally:
            pending_path.unlink(missing_ok=True)

    encryption_info = None
    if passphrase_file:
        from src.backup_encryption import BackupEncryptionError, encrypt_backup

        try:
            secret = _read_passphrase_file(passphrase_file)
            encryption_info = encrypt_backup(
                plaintext_path, out_path, secret, overwrite=False
            )
        except BackupEncryptionError as exc:
            fail(str(exc))
        finally:
            plaintext_path.unlink(missing_ok=True)

    # The archive contains the Fernet key and credential-bearing runtime
    # state. A permissive host umask must never leave it group/world-readable.
    # Windows user-profile ACLs are the security boundary there; POSIX modes
    # are applied where the platform supports them.
    if os.name != "nt" and (out_path.stat().st_mode & 0o077):
        fail("backup was created but owner-only permissions could not be applied")

    emit({
        "ok": True,
        "path": str(out_path),
        "files": files_added,
        "uncompressed_bytes": total_bytes,
        "compressed_bytes": out_path.stat().st_size,
        "ratio": round(out_path.stat().st_size / max(total_bytes, 1), 4),
        "included_research": bool(args.include_research),
        "included_attachments": bool(args.include_attachments),
        "encrypted": bool(encryption_info),
        "encryption": {
            "algorithm": encryption_info.algorithm,
            "format_version": encryption_info.version,
        } if encryption_info else None,
    }, args)


def cmd_list(args):
    """List entries in `backups/`. Most recent first."""
    if not _BACKUP_DIR.is_dir():
        emit([], args)
        return
    entries = []
    for p in sorted(_BACKUP_DIR.iterdir(), key=lambda x: x.stat().st_mtime, reverse=True):
        if not p.is_file():
            continue
        entries.append({
            "path": str(p),
            "name": p.name,
            "bytes": p.stat().st_size,
            "modified": datetime.fromtimestamp(p.stat().st_mtime).isoformat(),
        })
    emit(entries, args)


def cmd_verify(args):
    """Open the tarball read-only and walk its members — confirms
    integrity without extracting anything."""
    path = Path(args.path)
    if not path.exists():
        fail(f"no file at {path}")
    from src.backup_encryption import is_encrypted_backup
    encrypted = is_encrypted_backup(path)
    try:
        with _materialized_backup(path, getattr(args, "passphrase_file", None)) as plain:
            with tarfile.open(plain, "r:gz") as tar:
                members = tar.getmembers()
                _validate_restore_members(members)
    except (tarfile.TarError, OSError) as e:
        fail(f"tarball is corrupt: {e}")
    emit({
        "ok": True,
        "path": str(path),
        "members": len(members),
        "first": members[0].name if members else None,
        "last": members[-1].name if members else None,
        "encrypted": encrypted,
    }, args)


def cmd_encrypt(args):
    from src.backup_encryption import BackupEncryptionError, encrypt_backup

    source = Path(args.path)
    destination = Path(args.out)
    secret = _read_passphrase_file(args.passphrase_file)
    try:
        info = encrypt_backup(source, destination, secret, overwrite=False)
    except BackupEncryptionError as exc:
        fail(str(exc))
    emit({
        "ok": True,
        "path": str(destination),
        "encrypted": True,
        "algorithm": info.algorithm,
        "format_version": info.version,
        "plaintext_bytes": info.plaintext_size,
        "encrypted_bytes": info.encrypted_size,
    }, args)


def _validate_restore_members(members):
    """Reject archive entries that can escape data/ during restore."""
    if not members:
        fail("refusing an empty backup archive")
    seen = set()
    for m in members:
        rel = PurePosixPath(m.name)
        normalized = str(rel)
        if normalized in seen:
            fail(f"refusing tarball with duplicate entry: {m.name!r}")
        seen.add(normalized)
        if rel.is_absolute() or ".." in rel.parts:
            fail(f"refusing tarball with absolute/parent path: {m.name!r}")
        if not rel.parts or rel.parts[0] != "data":
            fail(f"refusing tarball with entry outside data/: {m.name!r}")
        if m.issym() or m.islnk():
            fail(f"refusing tarball with link entry: {m.name!r}")
        if not (m.isdir() or m.isfile()):
            fail(f"refusing tarball with special file entry: {m.name!r}")


def _extract_restore_members(tar, members, root: Path) -> None:
    """Extract only regular files/directories after validation."""
    for m in members:
        target = root.joinpath(*PurePosixPath(m.name).parts)
        if m.isdir():
            target.mkdir(parents=True, exist_ok=True)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        src = tar.extractfile(m)
        if src is None:
            fail(f"extract failed: could not read {m.name!r}")
        with src, open(target, "wb") as dst:
            shutil.copyfileobj(src, dst)
        if os.name != "nt":
            os.chmod(target, int(m.mode) & 0o777)


def cmd_restore(args):
    """Overwrite `data/` from a tarball. Destructive; requires --yes."""
    path = Path(args.path)
    if not path.exists():
        fail(f"no file at {path}")
    if not args.yes:
        fail("restore is destructive — pass --yes to confirm overwriting data/")
    # Validate and fully extract beside the live directory first. Only a
    # complete staged tree is atomically swapped into place; malformed or
    # truncated backups therefore leave the current data untouched.
    stash = None
    with _materialized_backup(path, getattr(args, "passphrase_file", None)) as plain:
        with tarfile.open(plain, "r:gz") as tar:
            members = tar.getmembers()
            _validate_restore_members(members)
            with tempfile.TemporaryDirectory(
                prefix=".restia-restore-", dir=_DATA_DIR.parent
            ) as staged_root_raw:
                staged_root = Path(staged_root_raw)
                _extract_restore_members(tar, members, staged_root)
                staged_data = staged_root / "data"
                if not staged_data.is_dir():
                    fail("refusing backup without a data directory")

                if _DATA_DIR.exists() or _DATA_DIR.is_symlink():
                    stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
                    stash = _DATA_DIR.with_name(
                        f"{_DATA_DIR.name}.before-restore-{stamp}"
                    )
                    os.rename(_DATA_DIR, stash)
                try:
                    os.replace(staged_data, _DATA_DIR)
                except BaseException:
                    if stash is not None and stash.exists() and not _DATA_DIR.exists():
                        os.rename(stash, _DATA_DIR)
                    raise

    key_file = _DATA_DIR / ".app_key"
    if os.name != "nt" and key_file.exists():
        os.chmod(key_file, 0o600)
    emit({
        "ok": True,
        "restored_from": str(path),
        "previous_data_stashed_at": str(stash) if stash else None,
    }, args)


def _build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--pretty", action="store_true")
    p = argparse.ArgumentParser(prog="odysseus-backup", parents=[common])
    sub = p.add_subparsers(dest="cmd", required=True)

    ps = sub.add_parser("snapshot", parents=[common])
    ps.add_argument("--out", help="output path (default: backups/<timestamp>.tar.gz)")
    ps.add_argument("--include-research", action="store_true",
                    help="include data/deep_research/ (skipped by default; large)")
    ps.add_argument("--include-attachments", action="store_true",
                    help="include data/mail-attachments/ (skipped by default; re-derivable)")
    ps.add_argument(
        "--encrypt-with-passphrase-file",
        metavar="PATH",
        help="encrypt with an external owner-only passphrase file",
    )
    ps.set_defaults(func=cmd_snapshot)

    pl = sub.add_parser("list", parents=[common])
    pl.set_defaults(func=cmd_list)

    pv = sub.add_parser("verify", parents=[common])
    pv.add_argument("path")
    pv.add_argument("--passphrase-file", help="owner-only file for encrypted backup")
    pv.set_defaults(func=cmd_verify)

    pe = sub.add_parser("encrypt", parents=[common])
    pe.add_argument("path", help="existing plaintext Restia tar.gz backup")
    pe.add_argument("--out", required=True, help="encrypted .restia destination")
    pe.add_argument("--passphrase-file", required=True, help="owner-only passphrase file")
    pe.set_defaults(func=cmd_encrypt)

    pr = sub.add_parser("restore", parents=[common])
    pr.add_argument("path")
    pr.add_argument("--yes", action="store_true",
                    help="confirm overwriting current data/")
    pr.add_argument("--passphrase-file", help="owner-only file for encrypted backup")
    pr.set_defaults(func=cmd_restore)

    return p


if __name__ == "__main__":
    sys.exit(run(_build_parser()))
