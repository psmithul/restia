#!/usr/bin/env python3
"""Owner-explicit CLI for Restia's database-backed contacts authority.

    odysseus-contacts --owner alice list
    odysseus-contacts --owner alice search example.com
    odysseus-contacts --owner alice add --name "Alice" --email alice@example.com
"""

from __future__ import annotations

import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "_lib"))
from cli import emit, fail, quiet_logs, run  # noqa: E402

quiet_logs()

try:
    from core.database import SessionLocal
    from src.audit_context import bind_service_audit_context
    from src.contact_delivery import drain_contact_deliveries
    from src.contact_legacy_import import (
        ContactLegacyImportError,
        adopt_legacy_contacts,
    )
    from src.contact_service import (
        create_contact,
        get_contact_config,
        list_contacts,
    )
    from src.database_runtime import initialize_database
    from src.identity import find_account
    quiet_logs()
except ModuleNotFoundError as exc:
    fail(f"{exc}\nhint: run from the Restia checkout or installed package.", code=2)


def _contact_rows(contacts):
    return [row for row in contacts or [] if isinstance(row, dict)]


def _with_owner(args, operation, *, write: bool = False):
    _initialize()
    owner = str(getattr(args, "owner", "") or "").strip().lower()
    if not owner:
        fail("--owner is required (or set RESTIA_OWNER)")
    db = SessionLocal()
    try:
        account = find_account(db, owner)
        if account is None:
            fail("owner is not linked to a Restia account")
        owner_id = account.id
        db.rollback()
        drain_contact_deliveries(SessionLocal, owner_id=owner_id, limit=1)
        bind_service_audit_context(
            db,
            account_id=owner_id,
            interface="cli",
            actor_type="account",
            credential_type="local_cli",
        )
        result = operation(db, owner_id)
        db.commit()
        if write:
            drain_contact_deliveries(SessionLocal, owner_id=owner_id, limit=1)
        return result
    except SystemExit:
        db.rollback()
        raise
    except Exception as exc:
        db.rollback()
        fail(f"contact operation failed: {type(exc).__name__}")
    finally:
        db.close()


def cmd_list(args) -> None:
    rows = _contact_rows(_with_owner(
        args,
        lambda db, owner_id: list_contacts(
            db,
            owner_id=owner_id,
            refresh=args.refresh,
            create_local=False,
        ),
    ))
    emit(rows, args)


def cmd_search(args) -> None:
    needle = args.query.lower()
    rows = _contact_rows(_with_owner(
        args,
        lambda db, owner_id: list_contacts(
            db, owner_id=owner_id, refresh=False, create_local=False,
        ),
    ))
    matches = [
        row for row in rows
        if needle in str(row.get("name") or "").lower()
        or any(
            needle in str(email or "").lower()
            for email in row.get("emails") or []
        )
    ]
    emit(matches, args)


def cmd_add(args) -> None:
    contact = _with_owner(
        args,
        lambda db, owner_id: create_contact(
            db, owner_id=owner_id, name=args.name, email=args.email,
        ),
        write=True,
    )
    emit({"ok": True, "contact": contact}, args)


def cmd_config(args) -> None:
    emit(_with_owner(
        args,
        lambda db, owner_id: get_contact_config(db, owner_id=owner_id),
    ), args)


def _build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--pretty", action="store_true", help="Pretty-print JSON")
    common.add_argument(
        "--owner",
        default=os.environ.get("RESTIA_OWNER", ""),
        help="Restia account username (or set RESTIA_OWNER)",
    )
    parser = argparse.ArgumentParser(
        prog="odysseus-contacts",
        description="Owner-scoped Restia contacts CLI.",
        parents=[common],
    )
    sub = parser.add_subparsers(dest="cmd", required=True)
    list_parser = sub.add_parser("list", parents=[common])
    list_parser.add_argument("--refresh", action="store_true")
    list_parser.set_defaults(func=cmd_list)
    search_parser = sub.add_parser("search", parents=[common])
    search_parser.add_argument("query")
    search_parser.set_defaults(func=cmd_search)
    add_parser = sub.add_parser("add", parents=[common])
    add_parser.add_argument("--name", required=True)
    add_parser.add_argument("--email", required=True)
    add_parser.set_defaults(func=cmd_add)
    config_parser = sub.add_parser("config", parents=[common])
    config_parser.set_defaults(func=cmd_config)
    return parser


_initialized = False


def _initialize() -> None:
    global _initialized
    if _initialized:
        return
    initialize_database()
    try:
        adopt_legacy_contacts()
    except ContactLegacyImportError as exc:
        fail(f"contacts database cutover is locked: {exc.code}", code=2)
    _initialized = True


if __name__ == "__main__":
    sys.exit(run(_build_parser()))
